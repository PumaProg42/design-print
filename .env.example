# Print Relay Service Configuration
# Local print relay service URL (default: http://localhost:8080)
# Change this to your print relay server's address if running on a different machine
# Examples:
#   http://localhost:8080 (same machine)
#   http://print-relay.local:8080 (hostname)
#   http://192.168.1.50:8080 (specific IP)
VITE_PRINT_RELAY_URL=http://localhost:8080

# Instructions:
# 1. Copy this file to .env
# 2. Set up the print relay service (see print-relay-service/README.md)
# 3. Update VITE_PRINT_RELAY_URL with your relay server's address
# 4. Restart your development server
